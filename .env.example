# Public deployment URL used for canonical, sitemap, and social metadata.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Public token from a Google Search Console URL-prefix property's HTML-tag method.
GOOGLE_SITE_VERIFICATION=your-google-site-verification-token

# Optional public profile links. Omit any profile that should not be rendered.
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-handle
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/your-handle
NEXT_PUBLIC_X_URL=https://x.com/your-handle
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/your-handle/portfolio

# Server-only contact delivery settings for the Resend REST API.
RESEND_API_KEY=re_your_api_key
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=Portfolio <portfolio@your-verified-domain.example>

# Required in production for privacy-preserving distributed contact throttling.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
CONTACT_RATE_LIMIT_SALT=replace-with-at-least-32-random-characters
