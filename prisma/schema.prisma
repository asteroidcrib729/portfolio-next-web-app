generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Post {
  id                String     @id @default(cuid())
  slug              String     @unique @db.VarChar(160)
  title             String     @db.VarChar(120)
  excerpt           String     @db.VarChar(320)
  content           String     @db.Text
  status            PostStatus @default(DRAFT)
  tags              String[]   @default([])
  focusKeyword      String?    @db.VarChar(120)
  seoTitle          String?    @db.VarChar(70)
  seoDescription    String?    @db.VarChar(170)
  canonicalUrl      String?    @db.VarChar(2048)
  socialImageUrl    String?    @db.VarChar(2048)
  socialImageAlt    String?    @db.VarChar(180)
  noIndex           Boolean    @default(false)
  publishedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([updatedAt])
}

model RateLimitBucket {
  key             String   @id @db.VarChar(96)
  count           Int      @default(1)
  windowStartedAt DateTime
  expiresAt       DateTime

  @@index([expiresAt])
}
